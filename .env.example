# Copy to .env (never commit .env).

# Shared secret between the desktop app and the local backend during development.
# The packaged app will generate one per session instead.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEXMIND_API_TOKEN=

# Backend port (bound to 127.0.0.1 only). Used by both the backend and the desktop app.
HEXMIND_PORT=8765

# Renderer origins allowed by backend CORS (JSON list).
HEXMIND_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL from docker-compose (port 5433 to avoid clashing with a local install).
# HEXMIND_DB_PASSWORD is read by docker-compose; keep it in sync with the URL below.
HEXMIND_DB_PASSWORD=hexmind
HEXMIND_DATABASE_URL=postgresql+asyncpg://hexmind:hexmind@127.0.0.1:5433/hexmind

# Local model provider.
HEXMIND_OLLAMA_URL=http://127.0.0.1:11434
HEXMIND_OLLAMA_MODEL=qwen2.5-coder:7b

# Hosted model providers (optional). A provider without a key is skipped. The conventional
# GROQ_API_KEY / GEMINI_API_KEY names also work. Keys stay in the backend; the app never shows them.
HEXMIND_GROQ_API_KEY=
HEXMIND_GROQ_MODEL=openai/gpt-oss-120b
HEXMIND_GEMINI_API_KEY=
HEXMIND_GEMINI_MODEL=gemini-3.5-flash

# Provider order (JSON list). Unconfigured/unavailable providers are skipped; Ollama is the
# local fallback. Optional per-complexity override, e.g. {"low": ["ollama", "groq", "gemini"]}.
HEXMIND_PROVIDER_ORDER=["groq", "gemini", "ollama"]
# HEXMIND_PROVIDER_ORDER_BY_COMPLEXITY={"low": ["ollama", "groq", "gemini"]}

# Where run worktrees, the memory store and crew storage live. Defaults to %LOCALAPPDATA%\hexmind on Windows.
# HEXMIND_DATA_DIR=

# CrewAI crew service (A2A). In development the backend starts it for you.
# HEXMIND_CREW_SERVICE_URL=http://127.0.0.1:8766
# HEXMIND_CREW_SERVICE_AUTOSTART=true

# Optional OpenTelemetry export target, e.g. a local Phoenix at http://127.0.0.1:6006/v1/traces
# HEXMIND_OTLP_ENDPOINT=
